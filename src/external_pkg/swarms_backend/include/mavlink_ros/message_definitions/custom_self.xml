    <messages>

        <message id="13026" name="UAV_MAVLINK_COMMAND" >
            <description>uav mavlink command</description>
            <field type="uint16_t" name="command" enum="UAV_COMMAND">Command ID (of command to send).</field>
        </message>

        <message id="13027" name="UAV_STATE" >
            <description>机器人状态消息，包含主要状态和位置信息</description>
            <field type="uint16_t" name="vehicle_id" />
            <field type="int32_t" name="robotMajorState" enum="ROBOT_STATE" />

            <field type="uint8_t" name="connected" />
            <field type="uint8_t" name="armed" />
            <field type="uint8_t" name="guided" />
            <field type="uint8_t" name="manual_input" />
            <field type="char[30]" name="mode" />
            <field name="mode_len"  type="uint16_t">len</field>
        
            <field type="int8_t" name="status" />
            <field type="uint16_t" name="service" />
            <field type="int32_t" name="latitude" />
            <field type="int32_t" name="longitude" />
            <field type="int32_t" name="altitude" />

        </message>

