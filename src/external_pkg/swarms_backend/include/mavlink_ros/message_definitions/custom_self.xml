        <message id="13028" name="STREAM_FEEDBACK">
            <description>流反馈消息</description>
            <field type="uint16_t" name="vehicle_id" />
            <field type="uint8_t" name="data" />
        </message>

        <message id="13029" name="FOLLOW_COVER_PASS_WAYPOINT">
            <description>跟随覆盖任务的通过航点消息</description>
            <field type="uint16_t" name="vehicle_id" />
            <field type="uint8_t" name="groupId" />
            <field type="uint16_t" name="currentPointId" />
        </message>

        <message id="13030" name="CAN_CONFIRMED_FLAG">
            <description>确认标志消息</description>
            <field type="uint16_t" name="vehicle_id" />
            <field type="uint8_t" name="data" ></field>
        </message>

        <message id="13031" name="TARGETS_ITEM">
            <description>目标信息消息，包含多个目标</description>
            <field type="uint16_t" name="vehicle_id" />
            <field type="uint32_t" name="current" />
            <field type="uint32_t" name="target_count" />
            <field type="int32_t" name="type" />
            <field type="int32_t" name="latitude" />
            <field type="int32_t" name="longitude" />
            <field type="int32_t" name="altitude" />
        </message>

    </messages>
